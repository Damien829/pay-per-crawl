  "resolve": {
    "terms": {
      "default": "deny",
      "uses": { "search": { "access": "allow" }, "answer": { "access": "allow" }, "training": { "access": "deny" } },
      "paths": [
        { "match": "/blog/*", "uses": { "training": { "access": "paid", "price": { "amount": "0.002", "currency": "USD", "per": "page" } } } },
        { "match": "/blog/drafts/*", "uses": { "search": { "access": "deny" }, "training": { "access": "deny" } } },
        { "match": "/blog/draft-*", "uses": { "training": { "access": "deny" } } },
        { "match": "/members/*", "uses": { "search": { "access": "deny" }, "answer": { "access": "deny" } } },
        { "match": "/api/*/status", "uses": { "agent": { "access": "allow" } } },
        { "match": "/blog/x-*", "uses": { "search": { "access": "deny" } } },
        { "match": "/t/a*", "uses": { "agent": { "access": "allow" } } },
        { "match": "/t/*a", "uses": { "agent": { "access": "paid", "price": { "amount": "0.01", "currency": "USD", "per": "request" } } } },
        { "match": "/blog/x-1", "uses": { "training": "deny" } },
        { "match": "/caf\u00e9/*", "uses": { "agent": { "access": "allow" } } },
        { "match": "/~user", "uses": { "agent": { "access": "allow" } } },
        { "match": "/\ud83d\ude00/*", "uses": { "agent": { "access": "allow" } } }
      ]
    },
    "cases": [
      { "name": "no path entry matches: the top-level use applies", "use": "search", "path": "/about", "access": "allow" },
      { "name": "a use missing from 'uses' falls back to 'default'", "use": "agent", "path": "/about", "access": "deny" },
      { "name": "a path entry overrides only the uses it lists", "use": "search", "path": "/blog/post", "access": "allow" },
      { "name": "a path entry overrides a listed use", "use": "training", "path": "/blog/post", "access": "paid" },
      { "name": "* stays within one path segment", "use": "training", "path": "/blog/2026/post", "access": "deny" },
      { "name": "two entries match: the most specific wins (most literal characters)", "use": "training", "path": "/blog/draft-1", "access": "deny" },
      { "name": "a deeper entry applies to deeper paths", "use": "training", "path": "/blog/drafts/x", "access": "deny" },
      { "name": "the more specific entry also wins for search", "use": "search", "path": "/blog/drafts/x", "access": "deny" },
      { "name": "members area denies answers", "use": "answer", "path": "/members/profile", "access": "deny" },
      { "name": "* in the middle of a pattern", "use": "agent", "path": "/api/v2/status", "access": "allow" },
      { "name": "a pattern must match the whole path", "use": "agent", "path": "/api/v2/status/extra", "access": "deny" },
      { "name": "the bare prefix does not match prefix/*", "use": "training", "path": "/blog", "access": "deny" },
      { "name": "each use is resolved on its own: an entry that doesn't list a use leaves it to the next matching entry that does", "use": "training", "path": "/blog/x-1", "access": "paid" },
      { "name": "... and the more specific entry still decides the use it lists", "use": "search", "path": "/blog/x-1", "access": "deny" },
      { "name": "two entries tie on literal characters: the first listed wins", "use": "agent", "path": "/t/aa", "access": "allow" },
      { "name": "the second of two tied entries applies where only it matches", "use": "agent", "path": "/t/ba", "access": "paid" },
      { "name": "a use that is not an object with a valid access counts as not listed", "use": "training", "path": "/blog/x-1", "access": "paid" },
      { "name": "* matches the empty string", "use": "training", "path": "/blog/", "access": "paid" },
      { "name": "non-ASCII in a pattern matches its UTF-8 percent-encoding", "use": "agent", "path": "/caf%C3%A9/menu", "access": "allow" },
      { "name": "percent-encoding hex digits compare case-insensitively", "use": "agent", "path": "/caf%c3%a9/menu", "access": "allow" },
      { "name": "an encoded unreserved character is the character itself", "use": "agent", "path": "/%7Euser", "access": "allow" },
      { "name": "an encoded slash is not a segment separator", "use": "agent", "path": "/caf%C3%A9/a%2Fb", "access": "allow" },
      { "name": "a character outside the BMP is one UTF-8 sequence, not two halves", "use": "agent", "path": "/%F0%9F%98%80/x", "access": "allow" },
      { "name": "... and a different emoji does not match it", "use": "agent", "path": "/%F0%9F%99%82/x", "access": "deny" }
    ]
  },
  "signals": {
    "about": "Signals for existing readers (draft-ovalles-ai-terms-03): the IETF aipref vocabulary as a Content-Usage value, and robots.txt rules for training-only crawlers. 'content_usage' cases give the exact Content-Usage value for a response at a path, under the case's own 'terms' or else the 'resolve' terms above (\"\" means no Content-Usage is sent). 'robots' cases say what an RFC 9309 reader (longest match wins, Allow wins a tie; Content-Usage lines matched the same way, per draft-ietf-aipref-attach) must conclude from the robots.txt a generator writes for the terms. 'fetch' is whether the agent may fetch the path; 'content_usage' is the preference it reads there (checked only where it may fetch: no preference is implied for a disallowed path). For the policy token __usage_ai-training (draft-kelley-aipref-training-preference-signal), 'fetch' is the training preference itself (true = training welcome), read from its own group only: a * group never applies to it. Generators may write different lines as long as every check holds. A reader that does not generate robots.txt can skip 'robots'.",
    "content_usage": [
      {"name": "no path entry: training deny is train-ai=n; answer allowed and agent denied states no ai-use; search=y is not stated while training is not allowed (aipref Search also allows training for search)", "path": "/about", "value": "train-ai=n"},
      {"name": "training paid is train-ai=n too", "path": "/blog/post", "value": "train-ai=n"},
      {"name": "answer and agent both denied: ai-use=n", "path": "/members/profile", "value": "train-ai=n, ai-use=n"},
      {"name": "answer and agent both allowed: ai-use=y", "path": "/api/v2/status", "value": "train-ai=n, ai-use=y"},
      {"name": "the bare prefix takes the top level", "path": "/blog", "value": "train-ai=n"},
      {"name": "every use allowed: y for all three", "path": "/", "value": "train-ai=y, ai-use=y, search=y", "terms": {"default": "allow", "uses": {"search": {"access": "allow"}, "answer": {"access": "allow"}, "training": {"access": "allow"}, "agent": {"access": "allow"}}}},
      {"name": "search denied with training allowed: search is not stated (it would be search=n for every search engine)", "path": "/", "value": "train-ai=y, ai-use=y", "terms": {"default": "allow", "uses": {"search": {"access": "deny"}, "answer": {"access": "allow"}, "training": {"access": "allow"}, "agent": {"access": "allow"}}}},
      {"name": "report_only: the site has chosen no terms, so nothing is stated", "path": "/", "value": "", "terms": {"default": "allow", "report_only": true, "uses": {"search": {"access": "allow"}, "answer": {"access": "allow"}, "training": {"access": "allow"}, "agent": {"access": "allow"}}}}
    ],
    "robots": [
      {"name": "every use allowed", "terms": {"default": "allow", "uses": {"search": {"access": "allow"}, "answer": {"access": "allow"}, "training": {"access": "allow"}, "agent": {"access": "allow"}}}, "checks": [{"agent": "GPTBot", "path": "/post", "fetch": true, "content_usage": "train-ai=y, ai-use=y, search=y"}, {"agent": "SomeBot", "path": "/", "fetch": true, "content_usage": "train-ai=y, ai-use=y, search=y"}, {"agent": "__usage_ai-training", "path": "/", "fetch": true}]},
      {"name": "training paid site-wide: training-only crawlers disallowed, search and on-demand fetchers not", "terms": {"default": "allow", "uses": {"search": {"access": "allow"}, "answer": {"access": "allow"}, "training": {"access": "paid", "price": {"amount": "0.002", "currency": "USD", "per": "page"}}, "agent": {"access": "allow"}}}, "checks": [{"agent": "GPTBot", "path": "/post", "fetch": false}, {"agent": "ClaudeBot", "path": "/", "fetch": false}, {"agent": "Google-Extended", "path": "/post", "fetch": false}, {"agent": "CCBot", "path": "/post", "fetch": false}, {"agent": "OAI-SearchBot", "path": "/post", "fetch": true}, {"agent": "Claude-User", "path": "/post", "fetch": true}, {"agent": "PerplexityBot", "path": "/post", "fetch": true, "content_usage": "train-ai=n, ai-use=y"}, {"agent": "__usage_ai-training", "path": "/post", "fetch": false}]},
