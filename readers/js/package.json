  "license": "MIT",
  "author": "Damien Ovalles (AIPayGen)",
  "homepage": "https://aipaygen.com/ai-terms",
  "repository": { "type": "git", "url": "git+https://github.com/Damien829/pay-per-crawl.git", "directory": "readers/js" },
  "keywords": ["ai-terms", "ai", "crawler", "robots", "aipref", "x402", "licensing"],
  "type": "module",
  "main": "./dist/index.js",
